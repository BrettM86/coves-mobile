<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Same as ../ExportOptions.plist, except destination is "export" rather
         than "upload": fastlane does the upload, so xcodebuild must leave an
         IPA on disk instead of shipping it straight to App Store Connect. -->
    <key>method</key>
    <string>app-store-connect</string>
    <key>destination</key>
    <string>export</string>
    <key>signingStyle</key>
    <string>automatic</string>
    <key>teamID</key>
    <string>Z4N56CL767</string>
</dict>
</plist>
