# Coves iOS release lanes.
#
# Credentials required (not in git) -- App Store Connect API key:
#   ASC_KEY_ID      Key ID from App Store Connect > Users and Access > Integrations
#   ASC_ISSUER_ID   Issuer ID from the same page
#   ASC_KEY_PATH    Path to the downloaded AuthKey_<KEY_ID>.p8
#
# Usage:
#   cd ios && fastlane build     # IPA only, no upload
#   cd ios && fastlane beta      # build + upload to TestFlight
#   cd ios && fastlane release   # build + upload to App Store Connect (no submit)

default_platform(:ios)

# fastlane runs from ios/fastlane, so the Flutter project root is two up.
PROJECT_ROOT = File.expand_path("../..", __dir__)

require_relative File.join(PROJECT_ROOT, "tool/fastlane_flutter")

# NOTE: no --flavor here. The Xcode project only defines Debug/Profile/Release
# and a single Runner scheme; the Prod-*/Dev-* xcconfigs are not wired into it.
# A plain release build resolves to bundle id social.coves and, because
# EnvironmentConfig defaults to production, the production backend.
IPA_DIR = File.join(PROJECT_ROOT, "build/ios/ipa")

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    in_house: false,
  )
end

platform :ios do
  desc "Build a signed release IPA"
  lane :build do
    flutter(PROJECT_ROOT, "clean")
    flutter(PROJECT_ROOT, "pub", "get")
    flutter(
      PROJECT_ROOT,
      "build", "ipa",
      "--release",
      "--dart-define=ENVIRONMENT=production",
      "--export-options-plist=ios/fastlane/ExportOptions.plist",
    )

    # Flutter names the export after the Xcode target, so this is currently
    # Runner.ipa rather than Coves.ipa. Glob instead of hardcoding, so renaming
    # the target or setting PRODUCT_NAME does not silently break the lane.
    ipa = Dir[File.join(IPA_DIR, "*.ipa")].max_by { |f| File.mtime(f) }
    UI.user_error!("No IPA found in #{IPA_DIR}") if ipa.nil?
    UI.success("Built #{ipa}")
    ipa
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    ipa = build
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end

  desc "Build and upload to App Store Connect without submitting for review"
  lane :release do
    ipa = build
    upload_to_app_store(
      api_key: asc_api_key,
      ipa: ipa,
      # Review submission and metadata stay a deliberate click in the
      # App Store Connect UI.
      submit_for_review: false,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
    )
  end
end
